<!DOCTYPE html>

<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport"
content="width=device-width, initial-scale=1.0">

<link rel="stylesheet" href="../css/style.css">

<title>My Project | Fiastara Portfolio</title>

</head>



<body>

{{> navbar}}
{{> flash}}

<section class="my-project">

    <div class="page-title">

        <h1>My Projects</h1>

        <p>
            Showcase all projects that you have built using modern web technologies.
        </p>

    </div>

    <div class="project-form-card">

        <h2>Add New Project</h2>

        <form action="/my-project" method="POST">

            <input
                type="text"
                name="projectName"
                placeholder="Project Name"
                required>

            <div class="date-group">

                <div>

                    <label>Start Date</label>

                    <input
                        type="date"
                        name="startDate"
                        required>

                </div>

                <div>

                    <label>End Date</label>

                    <input
                        type="date"
                        name="endDate"
                        required>

                </div>

            </div>

            <textarea
                name="description"
                placeholder="Project Description"
                required></textarea>

            <div class="checkbox-group">

                <label>
                    <input type="checkbox" name="nodejs">
                    Node JS
                </label>

                <label>
                    <input type="checkbox" name="express">
                    Express
                </label>

                <label>
                    <input type="checkbox" name="bootstrap">
                    Bootstrap
                </label>

                <label>
                    <input type="checkbox" name="postgresql">
                    PostgreSQL
                </label>

            </div>

            <button type="submit">
                Add Project
            </button>

        </form>

    </div>

 <div class="my-projects-list">

    <h2>Featured Projects</h2>

    <div class="project-grid">


            {{#each projects}}

            <div class="project-card">

                <img src="{{image}}" alt="{{projectName}}">

                <div class="project-content">

                    <h3>{{projectName}}</h3>

                    <p>{{description}}</p>

                    <div class="tech-list">

                        {{#each technologies}}

                        <span>{{this}}</span>

                        {{/each}}

                    </div>

                    <div class="project-button">

                        <a href="/project/{{id}}" class="btn-detail">
                            Detail
                        </a>

                        <a href="/edit-project/{{id}}" class="btn-edit">
                            Edit
                        </a>

                        <a href="/delete-project/{{id}}" class="btn-delete">
                            Delete
                        </a>

                    </div>

                </div>

            </div>

            {{/each}}

        </div>

    </div>

</section>

{{> footer}}
</body>

</html>